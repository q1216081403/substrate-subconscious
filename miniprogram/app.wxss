/* SUBSTRATE · 潜意识图谱
   科技冷调设计系统 */

page {
  background: #060A18;
  color: #E8EEF8;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ---------- 色彩变量 ---------- */
.bg-root { background: #060A18; }
.bg-panel { background: #0C1428; }
.bg-card {
  background: rgba(18, 26, 48, 0.72);
  border: 1rpx solid rgba(57, 231, 255, 0.14);
  border-radius: 20rpx;
}

.c-cyan { color: #39E7FF; }
.c-violet { color: #7B6BFF; }
.c-dim { color: #5A6480; }
.c-text { color: #E8EEF8; }
.c-warn { color: #FF7B6B; }
.c-amber { color: #FFC14D; }

/* ---------- 网格背景 ---------- */
.grid-bg {
  background-image:
    linear-gradient(rgba(57, 231, 255, 0.045) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(57, 231, 255, 0.045) 1rpx, transparent 1rpx);
  background-size: 44rpx 44rpx;
}

.glow-cyan {
  box-shadow: 0 0 32rpx rgba(57, 231, 255, 0.22);
}

/* ---------- 标题 ---------- */
.page-title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1.3;
}

.page-sub {
  font-size: 24rpx;
  color: #5A6480;
  letter-spacing: 1rpx;
  margin-top: 10rpx;
}

.mono {
  font-family: "SF Mono", "Menlo", "Consolas", monospace;
  font-variant-numeric: tabular-nums;
}

.section-label {
  font-size: 20rpx;
  color: #39E7FF;
  letter-spacing: 4rpx;
  opacity: 0.75;
}

/* ---------- 按钮 ---------- */
.btn-primary {
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #39E7FF 0%, #7B6BFF 100%);
  color: #04101F;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 40rpx rgba(57, 231, 255, 0.35);
}

.btn-primary::after { border: none; }

.btn-ghost {
  height: 80rpx;
  border-radius: 40rpx;
  border: 1rpx solid rgba(57, 231, 255, 0.3);
  color: #39E7FF;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.btn-ghost::after { border: none; }

/* ---------- 进度条 ---------- */
.bar-track {
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #39E7FF, #7B6BFF);
  transition: width 0.6s ease;
}

/* ---------- 呼吸动画 ---------- */
@keyframes breathe {
  0%, 100% { opacity: 0.35; transform: scale(0.96); }
  50% { opacity: 1; transform: scale(1.04); }
}
.breathe { animation: breathe 2.6s ease-in-out infinite; }

@keyframes pulse-ring {
  0% { transform: scale(0.8); opacity: 0.7; }
  100% { transform: scale(1.6); opacity: 0; }
}
.pulse-ring { animation: pulse-ring 2s ease-out infinite; }

/* ---------- 数据流动画 ---------- */
@keyframes dataflow {
  0% { transform: translateY(-100%); }
  100% { transform: translateY(400%); }
}

@keyframes scanline {
  0% { top: -4%; }
  100% { top: 100%; }
}

/* ---------- 分隔 ---------- */
.hairline {
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(57,231,255,0.25), transparent);
}

/* 隐私提示条 */
.privacy-note {
  font-size: 20rpx;
  color: #4A5570;
  line-height: 1.6;
}
