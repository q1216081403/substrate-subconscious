<view class="page">
  <view class="section-label">STEP 02 · 画像</view>
  <view class="page-title">AI 看到了什么</view>
  <view class="page-sub">基于 {{user.days}} 天 / {{user.hours}} 小时 数据 · 置信度 {{user.confidence}}</view>

  <!-- 六维雷达（简化为条形） -->
  <view class="dim-card bg-card">
    <view class="section-label" style="margin-bottom: 24rpx;">人格维度图谱</view>
    <view class="dim" wx:for="{{dimensions}}" wx:key="name">
      <view class="dim-name">{{item.name}}</view>
      <view class="bar-track" style="flex: 1;">
        <view class="bar-fill" style="width: {{item.value}}%"></view>
      </view>
      <view class="dim-val mono">{{item.value}}</view>
    </view>
  </view>

  <!-- 核心发现卡片 -->
  <view class="section-label" style="margin: 44rpx 0 20rpx;">核心发现</view>

  <view
    class="finding bg-card"
    wx:for="{{findings}}"
    wx:key="id"
    data-i="{{index}}"
    bindtap="onToggle"
  >
    <view class="f-head">
      <view class="f-left">
        <view class="f-label">{{item.label}}</view>
        <view class="f-score mono">
          <text class="s-num" style="color: {{levelColor[item.level]}}">{{item.score}}</text>
          <text class="s-max">/100</text>
        </view>
      </view>
      <view class="f-arrow" style="transform: rotate({{expanded[item.id] ? 180 : 0}}deg)">▼</view>
    </view>

    <view class="f-meter">
      <view class="bar-track">
        <view class="bar-fill" style="width: {{item.score}}%; background: {{levelColor[item.level]}}"></view>
      </view>
    </view>

    <!-- 隐喻：把周围人看成什么 -->
    <view class="metaphor">
      <view class="m-tag">潜意识隐喻</view>
      <view class="m-name">「{{item.metaphor}}」</view>
      <view class="m-desc">{{item.metaphorDesc}}</view>
    </view>

    <view class="f-summary">{{item.summary}}</view>

    <!-- 证据链 -->
    <view class="evid" wx:if="{{expanded[item.id]}}">
      <view class="evid-title">证据链 · 原始观测</view>
      <view class="evid-item" wx:for="{{item.evidence}}" wx:for-item="e" wx:key="scene">
        <view class="e-row">
          <view class="e-scene">{{e.scene}}</view>
          <view class="e-gaze mono">{{e.gaze}}</view>
        </view>
        <view class="e-row">
          <view class="e-focus">焦点：{{e.focus}}</view>
          <view class="e-flag {{e.diverted ? 'bad' : 'good'}}">
            {{e.diverted ? '已偏离' : '真实接触'}}
          </view>
        </view>
      </view>
    </view>

    <view class="f-more mono">{{expanded[item.id] ? '收起' : '展开证据链'}}</view>
  </view>

  <!-- 关键一句 -->
  <view class="verdict">
    <view class="v-label">一句话总结</view>
    <view class="v-text">
      你不是不敏感，而是把<text class="c-cyan">敏感</text>用在了<text class="c-amber">判断</text>上，而不是<text class="c-violet">感受</text>上。
    </view>
  </view>

  <view class="btn-primary" bindtap="onGoWorld" style="margin-top: 40rpx;">生成我的潜意识世界</view>
</view>
