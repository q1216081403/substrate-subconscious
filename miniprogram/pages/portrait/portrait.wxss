.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.page-sub {
  font-size: 22rpx;
  color: #5A6480;
  letter-spacing: 0.5rpx;
  margin-top: 12rpx;
  margin-bottom: 36rpx;
}

/* ---------- 维度图谱 ---------- */
.dim-card { padding: 32rpx; }

.dim {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
}

.dim:last-child { margin-bottom: 0; }

.dim-name {
  width: 130rpx;
  font-size: 24rpx;
  color: #A8B2C8;
  flex-shrink: 0;
}

.dim-val {
  width: 70rpx;
  text-align: right;
  font-size: 24rpx;
  color: #39E7FF;
  flex-shrink: 0;
}

/* ---------- 发现卡片 ---------- */
.finding {
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.f-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.f-left { flex: 1; }

.f-label {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.f-score { display: flex; align-items: baseline; }

.s-num { font-size: 46rpx; font-weight: 800; }
.s-max { font-size: 20rpx; color: #5A6480; margin-left: 6rpx; }

.f-arrow {
  font-size: 20rpx;
  color: #5A6480;
  transition: transform 0.3s ease;
}

.f-meter { margin: 20rpx 0 24rpx; }

/* ---------- 隐喻 ---------- */
.metaphor {
  background: linear-gradient(135deg, rgba(57, 231, 255, 0.08), rgba(123, 107, 255, 0.08));
  border-left: 3rpx solid #39E7FF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 22rpx;
}

.m-tag {
  font-size: 19rpx;
  color: #39E7FF;
  letter-spacing: 3rpx;
  margin-bottom: 12rpx;
}

.m-name {
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}

.m-desc {
  font-size: 23rpx;
  color: #8A94AC;
  line-height: 1.65;
}

.f-summary {
  font-size: 24rpx;
  color: #A8B2C8;
  line-height: 1.75;
}

/* ---------- 证据链 ---------- */
.evid {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.07);
}

.evid-title {
  font-size: 20rpx;
  color: #5A6480;
  letter-spacing: 2rpx;
  margin-bottom: 18rpx;
}

.evid-item {
  background: rgba(255, 255, 255, 0.03);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
}

.e-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.e-row:last-child { margin-bottom: 0; }

.e-scene { font-size: 23rpx; color: #C8D0E0; }
.e-gaze { font-size: 22rpx; color: #39E7FF; }
.e-focus { font-size: 21rpx; color: #6E7893; }

.e-flag {
  font-size: 18rpx;
  padding: 5rpx 12rpx;
  border-radius: 6rpx;
}

.e-flag.bad { color: #FF7B6B; background: rgba(255, 123, 107, 0.12); }
.e-flag.good { color: #5BE8A8; background: rgba(91, 232, 168, 0.12); }

.f-more {
  text-align: center;
  font-size: 21rpx;
  color: #39E7FF;
  margin-top: 20rpx;
}

/* ---------- 结论 ---------- */
.verdict {
  margin-top: 20rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(57, 231, 255, 0.1), rgba(123, 107, 255, 0.06));
  border: 1rpx solid rgba(57, 231, 255, 0.2);
}

.v-label {
  font-size: 19rpx;
  color: #39E7FF;
  letter-spacing: 3rpx;
  margin-bottom: 16rpx;
}

.v-text {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.7;
}
