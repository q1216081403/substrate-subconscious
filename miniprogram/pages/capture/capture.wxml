<view class="page">
  <!-- 采集状态头 -->
  <view class="head">
    <view class="head-left">
      <view class="section-label">STEP 01 · 采集</view>
      <view class="page-title">正在观察你</view>
    </view>
    <view class="rec-badge mono" wx:if="{{recording}}">
      <view class="rec-dot"></view>
      <text>{{elapsed}}</text>
    </view>
    <view class="rec-badge idle mono" wx:else>
      <text>PAUSED</text>
    </view>
  </view>

  <!-- 摄像头画面 -->
  <view class="cam-wrap">
    <camera
      wx:if="{{authorized}}"
      id="cam"
      class="cam"
      device-position="front"
      flash="off"
      frame-size="small"
      binderror="onCamError"
    ></camera>

    <!-- 未授权：模拟预览 + 授权按钮 -->
    <view wx:else class="cam-fake">
      <image class="cam-fake-img" src="/assets/data_flow.png" mode="aspectFill" />
      <view class="cam-fake-mask">
        <view class="fake-title">需要摄像头与麦克风权限</view>
        <view class="fake-desc">数据全部在本机端处理，不上传原始画面与声音</view>
        <view class="btn-ghost fake-btn" bindtap="onAuthorize">开启权限</view>
      </view>
    </view>

    <!-- 实时分析 HUD -->
    <view class="hud" wx:if="{{authorized}}">
      <view class="hud-row">
        <view class="hud-item">
          <view class="hud-val mono">{{fps}}</view>
          <view class="hud-key">FPS</view>
        </view>
        <view class="hud-item">
          <view class="hud-val mono">{{faceCount}}</view>
          <view class="hud-key">人脸</view>
        </view>
        <view class="hud-item">
          <view class="hud-val mono">{{voice}}</view>
          <view class="hud-key">语气 Hz</view>
        </view>
      </view>
      <view class="wave">
        <view
          class="wave-bar"
          wx:for="{{bars}}"
          wx:key="*this"
          style="height: {{item}}%; animation-delay: {{index * 40}}ms"
        ></view>
      </view>
      <view class="hud-tags">
        <view class="hud-tag" wx:for="{{liveTags}}" wx:key="*this">{{item}}</view>
      </view>
    </view>
  </view>

  <!-- 数据累计 -->
  <view class="stats">
    <view class="stat">
      <view class="stat-num mono">{{daysTracked}}</view>
      <view class="stat-key">观测天数</view>
    </view>
    <view class="stat">
      <view class="stat-num mono">{{hoursCaptured}}</view>
      <view class="stat-key">累计小时</view>
    </view>
    <view class="stat">
      <view class="stat-num mono">{{samples}}</view>
      <view class="stat-key">有效样本</view>
    </view>
  </view>

  <!-- 采集维度说明 -->
  <view class="channels">
    <view class="section-label">采集维度</view>
    <view class="ch-list">
      <view class="ch" wx:for="{{channels}}" wx:key="k">
        <view class="ch-dot" style="background: {{item.c}}"></view>
        <view class="ch-body">
          <view class="ch-name">{{item.n}}</view>
          <view class="ch-desc">{{item.d}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 控制 -->
  <view class="ctrl">
    <view wx:if="{{!authorized}}" class="btn-primary" bindtap="onAuthorize">开启摄像头与麦克风</view>
    <view wx:else class="ctrl-row">
      <view class="ctrl-btn" bindtap="onToggle">{{recording ? '暂停采集' : '继续采集'}}</view>
      <view class="ctrl-btn ghost" bindtap="onGoPortrait">查看画像</view>
    </view>
  </view>
</view>
