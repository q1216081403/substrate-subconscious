<view class="page grid-bg">
  <!-- 顶部身份 -->
  <view class="hero">
    <view class="tagline mono">MULTIMODAL · CONCEPT DEMO</view>
    <view class="title">你的潜意识<span class="c-cyan">长什么样</span></view>
    <view class="desc">用摄像头和麦克风记录你三周，然后让 AI 把那些你自己都没意识到的判断，画给你看。</view>
  </view>

  <!-- 主视觉 -->
  <view class="visual">
    <image class="hero-img" src="/assets/avatar_wire.png" mode="aspectFill" />
    <view class="scan-line"></view>
    <view class="visual-tag mono">
      <view class="dot"></view>
      <text>ANALYSIS ENGINE · ONLINE</text>
    </view>
  </view>

  <!-- 三个能力步骤 -->
  <view class="steps">
    <view class="step">
      <view class="step-idx mono">01</view>
      <view class="step-body">
        <view class="step-title">观察你</view>
        <view class="step-desc">摄像头看视线与表情，麦克风听语气与停顿，全部在本机端处理。</view>
      </view>
    </view>
    <view class="step-connector"></view>
    <view class="step">
      <view class="step-idx mono">02</view>
      <view class="step-body">
        <view class="step-title">读懂你</view>
        <view class="step-desc">多模态模型从上万条数据里，找出你反复出现的判断模式。</view>
      </view>
    </view>
    <view class="step-connector"></view>
    <view class="step">
      <view class="step-idx mono">03</view>
      <view class="step-body">
        <view class="step-title">生成你的世界</view>
        <view class="step-desc">把结论变成一段视频：AI 按你的潜意识，渲染你的世界长什么样。</view>
      </view>
    </view>
  </view>

  <!-- 主 CTA -->
  <view class="cta-wrap">
    <view class="btn-primary" bindtap="onStart">开始观测我</view>
    <view class="privacy-note c-dim">概念 Demo · 所有数据均为模拟，可随时终止并删除</view>
  </view>
</view>
