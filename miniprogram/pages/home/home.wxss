.page {
  min-height: 100vh;
  padding: 48rpx 32rpx 60rpx;
  box-sizing: border-box;
}

/* ---------- HERO ---------- */
.hero { margin-bottom: 44rpx; }

.tagline {
  font-size: 19rpx;
  color: #39E7FF;
  letter-spacing: 3rpx;
  opacity: 0.7;
  margin-bottom: 24rpx;
}

.title {
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.25;
  letter-spacing: 1rpx;
}

.desc {
  font-size: 26rpx;
  color: #8A94AC;
  line-height: 1.75;
  margin-top: 22rpx;
}

/* ---------- 主视觉 ---------- */
.visual {
  position: relative;
  width: 100%;
  height: 560rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #080E1E;
  border: 1rpx solid rgba(57, 231, 255, 0.16);
  margin-bottom: 48rpx;
}

.hero-img {
  width: 100%;
  height: 100%;
  opacity: 0.92;
}

.scan-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #39E7FF, transparent);
  box-shadow: 0 0 24rpx rgba(57, 231, 255, 0.8);
  animation: scanline 3.4s linear infinite;
}

.visual-tag {
  position: absolute;
  left: 24rpx;
  bottom: 24rpx;
  display: flex;
  align-items: center;
  font-size: 19rpx;
  color: #39E7FF;
  letter-spacing: 2rpx;
  background: rgba(6, 10, 24, 0.75);
  padding: 12rpx 22rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(57, 231, 255, 0.25);
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #39E7FF;
  margin-right: 12rpx;
  animation: breathe 1.4s ease-in-out infinite;
}

/* ---------- 步骤 ---------- */
.steps { margin-bottom: 56rpx; }

.step {
  display: flex;
  align-items: flex-start;
}

.step-idx {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: rgba(57, 231, 255, 0.1);
  border: 1rpx solid rgba(57, 231, 255, 0.3);
  color: #39E7FF;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.step-body { flex: 1; padding-left: 28rpx; padding-top: 4rpx; }

.step-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.step-desc {
  font-size: 24rpx;
  color: #7A85A0;
  line-height: 1.7;
}

.step-connector {
  width: 1rpx;
  height: 36rpx;
  background: linear-gradient(180deg, rgba(57,231,255,0.35), rgba(57,231,255,0.05));
  margin-left: 36rpx;
}

/* ---------- CTA ---------- */
.cta-wrap { margin-top: 20rpx; }

.privacy-note {
  text-align: center;
  margin-top: 24rpx;
}
