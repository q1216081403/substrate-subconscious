<view class="page">
  <view class="section-label">STEP 03 · 具象化</view>
  <view class="page-title">你的潜意识世界</view>
  <view class="page-sub">AI 依据你的画像生成的影像——它不是记录，是还原</view>

  <!-- 生成进度 -->
  <view class="gen-bar" wx:if="{{generating}}">
    <view class="gen-text mono">GENERATING · {{genStep}}</view>
    <view class="bar-track" style="margin-top: 16rpx;">
      <view class="bar-fill" style="width: {{genProgress}}%"></view>
    </view>
    <view class="gen-pct mono">{{genProgress}}%</view>
  </view>

  <!-- 场景卡 -->
  <scroll-view class="scene-list" scroll-y="{{false}}" wx:else>
    <view
      class="scene {{active === index ? 'on' : ''}}"
      wx:for="{{scenes}}"
      wx:key="id"
      data-i="{{index}}"
      bindtap="onPick"
    >
      <view class="s-img-wrap">
        <image class="s-img" src="{{item.image}}" mode="aspectFill" />
        <view class="s-overlay"></view>
        <view class="s-idx mono">0{{index + 1}}</view>
      </view>

      <view class="s-body">
        <view class="s-sub mono" style="color: {{item.palette}}">{{item.subtitle}}</view>
        <view class="s-title">{{item.title}}</view>
        <view class="s-target">↳ {{item.target}}</view>
        <view class="s-narr">{{item.narration}}</view>

        <!-- 分镜脚本 -->
        <view class="shots" wx:if="{{active === index}}">
          <view class="shot" wx:for="{{item.shot}}" wx:for-item="sh" wx:key="t">
            <view class="sh-t mono">{{sh.t}}</view>
            <view class="sh-c">{{sh.c}}</view>
          </view>
          <view class="sh-prompt">
            <view class="sh-prompt-label">生成提示词 · PROMPT</view>
            <view class="sh-prompt-text mono">{{item.prompt}}</view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="btn-primary" wx:if="{{!generating}}" bindtap="onRegenerate">重新生成我的世界</view>

  <view class="tech-note">
    <view class="section-label" style="margin-bottom: 16rpx;">技术实现</view>
    <view class="tech-line">· 采集层：端侧视觉 + 声学模型，人脸框与声纹特征本地处理</view>
    <view class="tech-line">· 推理层：多模态大模型对齐 21 天行为序列，输出人格维度与隐喻</view>
    <view class="tech-line">· 生成层：文生视频模型按分镜脚本渲染，画面即你的潜意识投影</view>
    <view class="tech-line">· 全链路均为当前已成熟技术，本 demo 只演示可行性</view>
  </view>
</view>
