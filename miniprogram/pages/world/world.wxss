.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.page-sub {
  font-size: 22rpx;
  color: #5A6480;
  margin-top: 12rpx;
  margin-bottom: 36rpx;
}

/* ---------- 生成进度 ---------- */
.gen-bar {
  background: rgba(18, 26, 48, 0.8);
  border: 1rpx solid rgba(57, 231, 255, 0.2);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.gen-text {
  font-size: 22rpx;
  color: #39E7FF;
  letter-spacing: 2rpx;
}

.gen-pct {
  font-size: 22rpx;
  color: #39E7FF;
  text-align: right;
  margin-top: 12rpx;
}

/* ---------- 场景卡 ---------- */
.scene {
  background: rgba(18, 26, 48, 0.6);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
}

.scene.on {
  border-color: rgba(57, 231, 255, 0.32);
  box-shadow: 0 0 40rpx rgba(57, 231, 255, 0.1);
}

.s-img-wrap {
  position: relative;
  width: 100%;
  height: 420rpx;
  overflow: hidden;
}

.s-img {
  width: 100%;
  height: 100%;
  opacity: 0.55;
}

.scene.on .s-img { opacity: 0.9; }

.s-overlay {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 60%;
  background: linear-gradient(180deg, transparent, rgba(6, 10, 24, 0.95));
}

.s-idx {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: rgba(232, 238, 248, 0.35);
}

.s-body { padding: 0 28rpx 28rpx; margin-top: -80rpx; position: relative; }

.s-sub {
  font-size: 19rpx;
  letter-spacing: 3rpx;
  margin-bottom: 12rpx;
}

.s-title {
  font-size: 36rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}

.s-target {
  font-size: 21rpx;
  color: #8A94AC;
  margin-bottom: 18rpx;
}

.s-narr {
  font-size: 24rpx;
  color: #B0BACE;
  line-height: 1.75;
}

/* ---------- 分镜 ---------- */
.shots {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.07);
}

.shot {
  display: flex;
  margin-bottom: 16rpx;
}

.sh-t {
  width: 90rpx;
  font-size: 20rpx;
  color: #39E7FF;
  flex-shrink: 0;
  padding-top: 2rpx;
}

.sh-c {
  flex: 1;
  font-size: 22rpx;
  color: #8A94AC;
  line-height: 1.6;
}

.sh-prompt {
  margin-top: 24rpx;
  background: rgba(0, 0, 0, 0.35);
  border-radius: 12rpx;
  padding: 20rpx;
}

.sh-prompt-label {
  font-size: 18rpx;
  color: #5A6480;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.sh-prompt-text {
  font-size: 19rpx;
  color: #7B6BFF;
  line-height: 1.6;
  word-break: break-all;
}

/* ---------- 技术说明 ---------- */
.tech-note {
  margin-top: 44rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}

.tech-line {
  font-size: 21rpx;
  color: #6E7893;
  line-height: 1.9;
}
